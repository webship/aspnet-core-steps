{
  "name": "@webship-js/aspnet-core-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for the account pages every ASP.NET Core app with individual accounts has, a plugin for webship-js (Playwright and Cucumber): log in and out and the refusals of the login form, two-factor sign-in with a code worked out from the authenticator key, a locked-out account, the confirmation mail and the password reset through the mail catcher, the Manage pages (profile, email, password, two-factor set-up, personal data), registration refusals, a page only a role may open and the access-denied page, the anti-forgery token of every form, the app's error page and status code pages without debug information, and the validation messages of server-rendered forms.",
  "main": "tests/step-definitions/aspnet-core-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "tests/blazor/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "aspnet-core",
    "aspnetcore",
    "dotnet",
    "identity",
    "razor-pages",
    "blazor",
    "login",
    "two-factor",
    "antiforgery",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/aspnet-core-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/aspnet-core-steps/issues"
  },
  "homepage": "https://github.com/webship/aspnet-core-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
